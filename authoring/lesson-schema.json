{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flight Academy lesson",
  "type": "object",
  "required": ["metadata", "whyItMatters", "concepts", "steps", "practice", "commonMistakes", "checklist", "quiz", "completionCriteria", "sources"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["id", "title", "subtitle", "objective", "estimatedTime", "prerequisites", "level", "module"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 8 },
        "subtitle": { "type": "string", "minLength": 12 },
        "objective": { "type": "string", "minLength": 12 },
        "estimatedTime": { "type": "string" },
        "prerequisites": { "type": "array", "items": { "type": "string" } },
        "level": { "type": "integer", "minimum": 0 },
        "module": { "type": "string" },
        "visualStandardVersion": { "enum": [2, 3] }
      }
    },
    "whyItMatters": { "type": "string", "minLength": 30 },
    "concepts": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["term", "meaning"], "properties": { "term": { "type": "string" }, "meaning": { "type": "string" } } } },
    "steps": { "type": "array", "minItems": 3, "items": { "type": "object", "required": ["number", "title", "instruction", "explanation", "expectedResult", "visual", "simulatorAction"], "properties": { "number": { "type": "integer", "minimum": 1 }, "title": { "type": "string" }, "instruction": { "type": "string" }, "explanation": { "type": "string" }, "expectedResult": { "type": "string" }, "simulatorAction": { "type": "string" }, "warning": { "type": "string" }, "tip": { "type": "string" }, "requiredVisualCoverage": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["type", "status"], "properties": { "type": { "enum": ["cockpit", "instrument", "hardware", "chart", "exteriorView", "airport"] }, "status": { "enum": ["required", "notRequired"] }, "reason": { "type": "string", "minLength": 20 } }, "allOf": [{ "if": { "properties": { "status": { "const": "notRequired" } } }, "then": { "required": ["reason"] } }] } }, "referenceVisuals": { "type": "array", "items": { "$ref": "#/$defs/visual" } }, "visual": { "$ref": "#/$defs/visual" } } } },
    "operationalCompetency": { "type": "object", "required": ["competencyObjective", "competencyEvidence"], "properties": { "competencyObjective": { "type": "string", "minLength": 24 }, "competencyEvidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 16 } }, "transferExercise": { "type": "object", "required": ["scenario", "task", "expectedCompetency", "successCriteria"], "properties": { "scenario": { "type": "string", "minLength": 16 }, "task": { "type": "string", "minLength": 16 }, "expectedCompetency": { "type": "string", "minLength": 16 }, "successCriteria": { "type": "string", "minLength": 16 }, "hints": { "type": "array", "items": { "type": "string" } } } }, "futureLearningTargets": { "type": "array", "items": { "type": "string" } } } },
    "practice": { "type": "object", "required": ["title", "scenario", "task", "successSignal", "conceptDemonstrated", "possibleConfounders", "whyThisExerciseDemonstratesTheConcept"], "properties": { "title": { "type": "string" }, "scenario": { "type": "string" }, "task": { "type": "string" }, "successSignal": { "type": "string" }, "conceptDemonstrated": { "type": "string", "minLength": 12 }, "possibleConfounders": { "type": "array", "items": { "type": "string", "minLength": 12 } }, "whyThisExerciseDemonstratesTheConcept": { "type": "string", "minLength": 30 } } },
    "commonMistakes": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["mistake", "recovery"], "properties": { "mistake": { "type": "string" }, "recovery": { "type": "string" } } } },
    "checklist": { "type": "array", "minItems": 3, "items": { "type": "string" } },
    "quiz": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["question", "options", "answer"], "properties": { "question": { "type": "string" }, "options": { "type": "array", "minItems": 2, "items": { "type": "string" } }, "answer": { "type": "string" }, "explanation": { "type": "string" } } } },
    "completionCriteria": { "type": "array", "minItems": 2, "items": { "type": "string" } },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["title", "url"], "properties": { "title": { "type": "string" }, "url": { "type": "string" }, "verified": { "type": "boolean" } } } }
  },
  "$defs": {
    "visual": { "type": "object", "required": ["type", "alt", "purpose", "teaches", "primaryTeachingObjective", "userQuestionAnswered", "tiedToStep", "expectedObservation", "view", "visualCategory", "fidelity", "recognitionGoal", "recognizedElements", "actionAfterViewing"], "properties": { "type": { "enum": ["diagram", "annotatedDiagram", "controlHighlight", "instrumentDiagram", "flightPathDiagram", "comparisonDiagram", "airportDiagram", "chartExplanation"] }, "asset": { "type": "string" }, "alt": { "type": "string", "minLength": 20 }, "purpose": { "type": "string", "minLength": 20 }, "teaches": { "type": "string", "minLength": 20 }, "primaryTeachingObjective": { "type": "string", "minLength": 12 }, "perspective": { "type": "string", "minLength": 12 }, "movingElement": { "type": "string", "minLength": 3 }, "axisOfMovement": { "type": "string", "minLength": 3 }, "directionOfMovement": { "type": "string", "minLength": 3 }, "comparisonJustification": { "type": "string", "minLength": 20 }, "userQuestionAnswered": { "type": "array", "minItems": 1, "items": { "enum": ["dondeMirar", "queControlTocar", "queCambioEsperar", "queErrorEvitar"] } }, "tiedToStep": { "type": "integer", "minimum": 1 }, "expectedObservation": { "type": "string", "minLength": 20 }, "view": { "enum": ["vistaExterior", "instrumento", "controlFisico", "flujo", "comparacion"] }, "visualCategory": { "enum": ["conceptual", "reference"] }, "fidelity": { "enum": ["conceptual", "recreated-faithful", "real"] }, "recognitionGoal": { "type": "string", "minLength": 20 }, "recognizedElements": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } }, "actionAfterViewing": { "type": "string", "minLength": 20 }, "coverage": { "type": "array", "minItems": 1, "items": { "enum": ["cockpit", "instrument", "hardware", "chart", "exteriorView", "airport"] } }, "quality": { "type": "object", "required": ["sourceWidth", "sourceHeight", "intendedDisplayWidth", "supportsZoom", "detailTarget"], "properties": { "sourceWidth": { "type": "integer", "minimum": 1 }, "sourceHeight": { "type": "integer", "minimum": 1 }, "intendedDisplayWidth": { "type": "integer", "minimum": 1 }, "supportsZoom": { "const": true }, "detailTarget": { "type": "string", "minLength": 20 } } }, "requiresReference": { "type": "boolean" } } }
  }
}
